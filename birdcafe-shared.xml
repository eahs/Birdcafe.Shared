        /// <summary>
        /// Operational profit (Revenue minus COGS and Waste).
        /// </summary>
        public decimal NetProfit { get; set; }

        /// <summary>
        /// The player's total liquid cash balance after all daily calculations.
        /// </summary>
        public decimal CurrentMoney { get; set; }

