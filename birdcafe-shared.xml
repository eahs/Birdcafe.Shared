        /// </summary>
        public string ActionId { get; set; }

        /// <summary>
        /// Name displayed in the UI.
        /// </summary>
        public string DisplayName { get; set; }

        /// <summary>
        /// Cost in game currency to perform this action.
        /// </summary>
