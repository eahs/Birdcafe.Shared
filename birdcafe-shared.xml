        /// The type of product (Coffee, BakedGoods, etc.).
        /// </summary>
        public ProductType Type { get; set; }

        /// <summary>
        /// Display name of the product.
        /// </summary>
        public string Name { get; set; }

        /// <summary>
        /// The quantity currently in stock (before new purchases).
        /// </summary>
